# Choose which LLM provider to use: auto (default - tries OpenAI then Gemini),
# openai, gemini, or none (forces the deterministic rule-based fallback mode).
LLM_PROVIDER=auto

# OpenAI (optional) - https://platform.openai.com/api-keys
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (optional) - https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=''
GOOGLE_MODEL=gemini-1.5-flash

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
